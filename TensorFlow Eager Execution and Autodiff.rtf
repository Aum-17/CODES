\cf0 from sentence_transformers import SentenceTransformer\
import faiss, numpy as np\
from transformers import pipeline\
docs = ["Employees get 24 days of paid leave per year.",\
        "The office is closed on national holidays.",\
        "Remote work is allowed two days a week.",\
        "Health insurance covers employees and dependents."]\
emb = SentenceTransformer("all-MiniLM-L6-v2")\
E = emb.encode(docs, normalize_embeddings=True).astype("float32")\
idx = faiss.IndexFlatIP(E.shape[1]); idx.add(E)\
llm = pipeline("text2text-generation", model="google/flan-t5-base")\
\
def rag(q, k=2):\
    qv = emb.encode([q], normalize_embeddings=True).astype("float32")\
    _, I = idx.search(qv, k)\
    ctx = " ".join(docs[i] for i in I[0])\
    return llm(f"Answer using the context.\\nContext: \{ctx\}\\nQuestion: \{q\}\\nAnswer:",\
               max_new_tokens=50)[0]["generated_text"]\
print(rag("How many days of leave do employees get?"))\
print(rag("Can I work from home?"))\
