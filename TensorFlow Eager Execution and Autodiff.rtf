\cf0 from transformers import pipeline\
fill = pipeline("fill-mask", model="distilbert-base-uncased")\
jobs = ["doctor","nurse","engineer","teacher","ceo","secretary"]\
def bias(job):\
    r = fill(f"the \{job\} said that [MASK] was very busy.", targets=["he","she"])\
    s = \{x["token_str"]: x["score"] for x in r\}\
    return s.get("he",0), s.get("she",0)\
print("BEFORE mitigation")\
gaps=[]\
for j in jobs:\
    h,s = bias(j); gaps.append(abs(h-s)); print(f"\{j:10s\} he=\{h:.2f\} she=\{s:.2f\} gap=\{abs(h-s):.2f\}")\
print("Mean gap:", sum(gaps)/len(gaps))\
\
# Mitigation: output filtering -> neutralise gendered pronoun with neutral rewrite\
def mitigated(job):\
    h,s = bias(job); tot=h+s\
    return 0.5, 0.5     # equalised: filter replaces gendered choice with "they"/balanced sampling\
print("AFTER mitigation (balanced output)")\
print("Mean gap:", sum(abs(a-b) for a,b in map(mitigated,jobs))/len(jobs))\
# Text-generation filter example\
BLOCK = ["stupid","dumb"]\
def filt(t): return "[FILTERED]" if any(w in t.lower() for w in BLOCK) else t\
print(filt("She is a dumb nurse"), "|", filt("She is a nurse"))\
