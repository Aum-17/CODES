\cf0 import tensorflow as tf, numpy as np, matplotlib.pyplot as plt\
from tensorflow.keras import layers\
T=200; beta=np.linspace(1e-4,0.02,T).astype("float32")\
alpha=1-beta; abar=np.cumprod(alpha)\
(x,_),_=tf.keras.datasets.mnist.load_data()\
x=(x[...,None].astype("float32")/127.5-1)\
\
def build():\
    img=layers.Input((28,28,1)); t=layers.Input((1,))\
    te=layers.Dense(28*28)(layers.Dense(64,activation="relu")(t/T))\
    te=layers.Reshape((28,28,1))(te)\
    h=layers.Concatenate()([img,te])\
    for f in (32,64,64,32): h=layers.Conv2D(f,3,padding="same",activation="relu")(h)\
    return tf.keras.Model([img,t],layers.Conv2D(1,3,padding="same")(h))\
model=build(); opt=tf.keras.optimizers.Adam(1e-3)\
\
@tf.function\
def step(x0):\
    b=tf.shape(x0)[0]; t=tf.random.uniform((b,),0,T,tf.int32)\
    eps=tf.random.normal(tf.shape(x0)); ab=tf.reshape(tf.gather(abar,t),(-1,1,1,1))\
    xt=tf.sqrt(ab)*x0+tf.sqrt(1-ab)*eps\
    with tf.GradientTape() as g:\
        loss=tf.reduce_mean((eps-model([xt,tf.cast(t[:,None],tf.float32)]))**2)\
    opt.apply_gradients(zip(g.gradient(loss,model.trainable_variables),model.trainable_variables))\
    return loss\
ds=tf.data.Dataset.from_tensor_slices(x).shuffle(60000).batch(128)\
for ep in range(3):\
    for xb in ds: l=step(xb)\
    print(ep,float(l))\
\
# ---- Inference: reverse diffusion ----\
xt=tf.random.normal((8,28,28,1))\
for t in reversed(range(T)):\
    eps=model([xt,tf.fill((8,1),float(t))])\
    xt=(xt-beta[t]/np.sqrt(1-abar[t])*eps)/np.sqrt(alpha[t])\
    if t>0: xt+=np.sqrt(beta[t])*tf.random.normal(xt.shape)\
fig,ax=plt.subplots(1,8,figsize=(16,2))\
for i in range(8): ax[i].imshow(xt[i,...,0],cmap="gray"); ax[i].axis("off")\
plt.show()\
