\cf0 import random, matplotlib.pyplot as plt\
random.seed(1)\
class Agent:\
    def __init__(s, name, role, limit): s.name, s.role, s.limit, s.offer = name, role, limit, None\
    def decide(s, other_offer, rnd):\
        # buyer raises bid, seller lowers ask, each toward own limit\
        if s.role=="buyer":\
            if other_offer is not None and other_offer <= s.limit: return other_offer, True\
            s.offer = (s.offer or 20)+random.randint(3,8); s.offer=min(s.offer,s.limit)\
        else:\
            if other_offer is not None and other_offer >= s.limit: return other_offer, True\
            s.offer = (s.offer or 100)-random.randint(3,8); s.offer=max(s.offer,s.limit)\
        return s.offer, False\
buyer, seller = Agent("Buyer","buyer",70), Agent("Seller","seller",50)\
hist=[]; b_off=s_off=None\
for rnd in range(1,21):\
    b_off,done = buyer.decide(s_off,rnd)\
    if done: print(f"Round \{rnd\}: Seller accepts at \{b_off\}"); break\
    s_off,done = seller.decide(b_off,rnd)\
    hist.append((rnd,b_off,s_off))\
    print(f"Round \{rnd\}: buyer bids \{b_off\}, seller asks \{s_off\}")\
    if done: print(f"Round \{rnd\}: Buyer accepts at \{s_off\}"); break\
r,b,s = zip(*hist)\
plt.plot(r,b,label="Buyer"); plt.plot(r,s,label="Seller"); plt.legend()\
plt.xlabel("Round"); plt.ylabel("Price"); plt.title("Negotiation convergence"); plt.show()\
\
}